---
import { Image, getImage } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Topo from "@/components/Topo.astro";
import Icon from "@/components/Icon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getProjects } from "@/lib/projects";
import { homePath, ui, type Lang } from "@/i18n";
import aboutPhoto from "@/assets/thomas-mountains.jpg";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const otherLang: Lang = lang === "en" ? "fr" : "en";
const projects = await getProjects(lang);
const email = "thomasbach.contact@gmail.com";
const year = new Date().getFullYear();
const aboutImage = await getImage({ src: aboutPhoto, width: 600, format: "jpg" });

const socials = [
  { label: "GitHub", href: "https://github.com/thombach", icon: "github" },
  { label: "LinkedIn", href: "https://linkedin.com/in/thomasbachpro", icon: "linkedin" },
  { label: "itch.io", href: "https://thomasbach.itch.io/", icon: "itch" },
  { label: "Email", href: `mailto:${email}`, icon: "mail" },
] as const;

// Structured data so search engines tell this Thomas Bach apart from his namesakes.
const site = Astro.site ?? new URL("https://thomasbach.fr");
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Thomas Bach",
  url: new URL(homePath(lang), site).href,
  jobTitle: t.jobTitle,
  description: t.metaDescription,
  image: new URL(aboutImage.src, site).href,
  email: `mailto:${email}`,
  address: { "@type": "PostalAddress", addressLocality: "Lyon", addressCountry: "FR" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Polytech Grenoble" },
  sameAs: socials.filter((s) => s.href.startsWith("https://")).map((s) => s.href),
};
---

<Base lang={lang} title={t.metaTitle} description={t.metaDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />
  <a class="skip" href="#projects">{t.navProjects}</a>
  <header class="hero">
    <div class="wrap">
      <nav class="topbar" aria-label="Sections">
        <a href="#projects">{t.navProjects}</a>
        <a href="#about">{t.navAbout}</a>
        <a href="#contact">{t.navContact}</a>
        <a class="lang" href={homePath(otherLang)} hreflang={otherLang} lang={otherLang} aria-label={t.switchLangLabel}>
          <Icon name="languages" size={16} />
          {t.switchLang}
        </a>
      </nav>
      <div class="hero-inner">
        <div class="hero-text">
          <h1 class="name">Thomas<br />Bach</h1>
          <p class="role">{t.role}</p>
          <ul class="socials">
            {
              socials.map((s) => (
                <li>
                  <a href={s.href}>
                    <Icon name={s.icon} size={17} />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <Topo lang={lang} />
      </div>
    </div>
  </header>

  <main>
    <section class="block wrap" id="projects" aria-labelledby="h-projects">
      <h2 class="section-title" id="h-projects">{t.projects}</h2>
      <ul class="list">
        {projects.map((project, i) => <ProjectCard project={project} eager={i < 2} />)}
      </ul>
    </section>

    <section class="block wrap" id="about" aria-labelledby="h-about">
      <div class="about">
        <div>
          <h2 class="section-title" id="h-about">{t.about}</h2>
          {t.aboutText.map((p) => <p>{p}</p>)}
        </div>
        <Image src={aboutPhoto} alt={t.aboutAlt} width={600} widths={[300, 450, 600]} sizes="(min-width: 720px) 200px, 240px" format="webp" />
      </div>
    </section>

    <section class="block contact wrap" id="contact" aria-labelledby="h-contact">
      <h2 class="section-title" id="h-contact">{t.contact}</h2>
      <p>{t.contactText}</p>
      <div class="mail">
        <a id="mail" href={`mailto:${email}`}>{email}</a>
        <button class="copy" type="button" data-copy={email} data-done={t.copied} data-label={t.copy}>
          <Icon name="copy" size={16} class="i-copy" />
          <Icon name="check" size={16} class="i-check" />
          <span>{t.copy}</span>
        </button>
      </div>
    </section>
  </main>

  <footer class="site wrap">
    <span>Thomas Bach, {year}</span>
    <small>{t.demCredit}</small>
  </footer>
</Base>

<style>
  /* Faint kilometre grid, aligned on the map by Topo (1 km per square). */
  .hero {
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: var(--grid-step, 72px) var(--grid-step, 72px);
    background-position: var(--grid-x, 0) var(--grid-y, 0);
  }

  .topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 22px;
    padding-top: 24px;
    font-size: var(--step--1);
  }

  .topbar a {
    color: var(--ink);
    text-decoration: none;
  }

  .topbar a:hover {
    text-decoration: underline;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 48px;
    align-items: end;
    padding-block: 56px 64px;
  }

  .hero-text {
    display: grid;
    gap: 20px;
    align-content: end;
  }

  .name {
    font-size: var(--step-hero);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .role {
    margin: 0;
    max-width: 32ch;
    font-size: var(--step-1);
  }

  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.9375rem;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .block {
    padding-block: 88px 0;
  }

  .list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    gap: 40px;
    align-items: start;
  }

  .about p,
  .contact p {
    max-width: var(--measure);
    margin: 16px 0 0;
  }

  .about img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }

  .contact {
    padding-bottom: 64px;
  }

  .contact p {
    color: var(--muted);
  }

  .mail {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .mail a {
    font-family: var(--display);
    font-size: clamp(1.3rem, 4.5vw, 2.4rem);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: inherit;
    font-size: var(--step--1);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line-index);
    border-radius: 2px;
    padding: 6px 12px;
    cursor: pointer;
  }

  .copy:hover {
    border-color: var(--ink);
  }

  .copy :global(.i-check),
  .copy.done :global(.i-copy) {
    display: none;
  }

  .copy.done :global(.i-check) {
    display: block;
  }

  .site {
    border-top: 1px solid var(--line);
    padding-block: 20px 36px;
    color: var(--muted);
    font-size: var(--step--1);
    display: grid;
    gap: 6px;
  }

  .site small {
    font-size: 0.75rem;
    max-width: 80ch;
  }

  @media (max-width: 720px) {
    .topbar {
      justify-content: flex-start;
    }
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 40px 40px;
    }
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .about img {
      max-width: 240px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((button) => {
    const text = button.querySelector("span");
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.classList.add("done");
        if (text) text.textContent = button.dataset.done ?? "";
        setTimeout(() => {
          button.classList.remove("done");
          if (text) text.textContent = button.dataset.label ?? "";
        }, 1800);
      } catch {
        const target = document.getElementById("mail");
        if (!target) return;
        const range = document.createRange();
        range.selectNodeContents(target);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
      }
    });
  });
</script>
