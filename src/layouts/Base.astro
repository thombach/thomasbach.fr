---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@/styles/global.css";
import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import plexLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import { homePath, languages, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Set to false for pages that only exist once (404). */
  alternates?: boolean;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
}

const { lang, title, description, alternates = true, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://thomasbach.fr");
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      alternates &&
        languages.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(homePath(l), site)} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL("/", site)} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
